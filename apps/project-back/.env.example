NODE_ENV="development"
# user for logger library
LOG_LEVEL="info"
LOG_NAME="project-back"
LOKI_URL="http://localhost:3100"

# Main back Configuration
BACK_HOST="localhost"
BACK_PORT=3010
CORS_ORIGINS="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Auth configuration
BETTER_AUTH_SECRET=dev-better-auth-secret-min-32-chars!!
BETTER_AUTH_URL="http://localhost:3010"
AUTH_SESSION_CACHE_TTL_MS=30000
AUTH_SESSION_COOKIE_CACHE_MAX_AGE_SEC=300
AUTH_DEV_BYPASS=false


# File uploads — S3-compatible (optional)
# Local RustFS: from repo root run `pnpm docker:rustfs:init` — creates buckets from
# S3_* vars and writes AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY to .rustfs/credentials.env
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Internal S3-compatible endpoint (e.g. http://rustfs:9000 in Docker). Not exposed to browsers;
# uploads go through the API (PUT …/content routes) using this endpoint server-side.
S3_ENDPOINT=
# Optional HTTPS base for stable object URLs stored in the DB (not required for presigned GETs).
S3_PUBLIC_BASE_URL=

# S3 API examples:
# PUT /api/storage/objects/example.txt (raw request body)
# GET /api/storage/objects/example.txt
# GET /api/storage/objects?prefix=folder/
# POST /api/storage/presign-upload with { "key": "example.txt" }
# DELETE /api/storage/objects/example.txt
