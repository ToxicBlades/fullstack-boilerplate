{
  "name": "@project/back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node dist/index.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --watchman=false --no-cache",
    "db:migrate": "tsx src/db/migrate-latest.ts",
    "db:setup": "pnpm db:migrate && pnpm auth:migrate",
    "auth:migrate": "npx @better-auth/cli@latest migrate --config ./src/auth/auth-migrate.ts",
    "db:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "db:make": "knex migrate:make --knexfile knexfile.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:seed:reset": "tsx src/db/seed-cli.ts --reset",
    "db:reset-schema": "ALLOW_DB_NUKE=1 tsx src/db/reset-schema.ts"
  },
  "dependencies": {
    "@project/logger": "workspace:*",
    "cors": "^2.8.6",
    "better-auth": "^1.6.23",
    "dotenv": "^17.2.2",
    "envalid": "^8.1.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@project/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "ts-jest": "^29.3.4",
    "tsx": "^4.20.6",
    "tsup": "^8.5.0"
  }
}
