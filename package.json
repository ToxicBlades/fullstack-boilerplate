{
  "name": "@project/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "check": "ultracite check",
    "docker:rustfs:init": "sh scripts/local-init-rustfs.sh",
    "doctor": "npx react-doctor@latest",
    "e2e": "pnpm --filter @project/e2e test",
    "e2e:install": "pnpm --filter @project/e2e install:browsers",
    "e2e:ui": "pnpm --filter @project/e2e test:ui",
    "fix": "ultracite fix",
    "lint": "ultracite fix",
    "lint:fix": "ultracite fix --unsafe",
    "node_modules:clear": "sh scripts/clear-modules.sh",
    "setup": "sh scripts/setup.sh"
  },
  "dependencies": {
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "react-doctor": "^0.4.2",
    "ultracite": "7.11.0"
  }
}
