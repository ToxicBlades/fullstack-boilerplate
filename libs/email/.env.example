# This env values should be bundled with app which is using this library
# they should not be builded with this library or set within this folder


# Mailpit is default local(in docker) smtp test server
SMTP_HOST=mailpit 
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Company <noreply@company.app>"
SMTP_SECURE=false
# MX + SMTP RCPT TO check on sign-up (off in development by default; enable in production)
EMAIL_SMTP_VERIFY_ENABLED=false

